{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  // Must match the Worker name on the Cloudflare dashboard (Workers Builds)
  "name": "xiaoshley-birthday-evite",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // No "services" self-reference: this app has no ISR/on-demand revalidation,
  // so WORKER_SELF_REFERENCE is not used (and would bind to a Worker name that
  // must exactly match "name" above).
  "r2_buckets": [
    // Only needed for the R2 incremental cache, together with a
    // WORKER_SELF_REFERENCE service binding to "xiaoshley-birthday-evite".
    // See https://opennext.js.org/cloudflare/caching
    // {
    //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
    //   "bucket_name": "xiaoshley-birthday-evite-opennext-cache",
    // },
  ],
  "images": {
    // Enable image optimization
    // see https://opennext.js.org/cloudflare/howtos/image
    "binding": "IMAGES",
  },
}
